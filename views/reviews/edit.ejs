<% layout("/layouts/boilerplate") %>
<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow rounded-4 border-0">

                <div class="card-body p-5">

                    <h2 class="mb-4">
                        Edit Review
                    </h2>

                    <form
                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=PUT"
                        method="POST">

                        <div class="mb-3">

                            <label class="form-label">
                                Rating
                            </label>

                            <select
                                class="form-select"
                                name="review[rating]">

                                <% for(let i=5; i>=1; i--){ %>

                                    <option
                                        value="<%= i %>"
                                        <%= review.rating == i ? "selected" : "" %>>

                                        <%= i %> Star

                                    </option>

                                <% } %>

                            </select>

                        </div>

                        <div class="mb-4">

                            <label class="form-label">

                                Comment

                            </label>

                            <textarea
                                class="form-control"
                                rows="5"
                                name="review[comment]"><%= review.comment %></textarea>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a
                                href="/listings/<%= listing._id %>"
                                class="btn btn-outline-secondary">

                                Cancel

                            </a>

                            <button
                                class="btn btn-primary">

                                Update Review

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>