<% layout("/layouts/boilerplate") %>
<section class="hero py-5">

    <div class="container">

        <div class="row align-items-center">

            <!-- Left -->

            <div class="col-lg-6">

                <span class="badge bg-danger rounded-pill px-3 py-2 mb-3">
                    🌍 Trusted by Travelers
                </span>

                <h1 class="display-3 fw-bold">

                    Find Your Perfect

                    <span class="text-danger">
                        Stay
                    </span>

                </h1>

                <p class="lead text-muted my-4">

                    Discover beautiful homes, cabins, villas,
                    and unique places around the world.

                </p>

                <a href="/listings" class="btn btn-danger btn-lg rounded-pill px-4 me-2">

                    Explore Listings

                </a>

                <a href="#" class="btn btn-outline-dark btn-lg rounded-pill px-4">

                    Learn More

                </a>

            </div>

            <!-- Right -->

            <div class="col-lg-6 text-center mt-5 mt-lg-0">

                <img
                src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=900"
                class="img-fluid rounded-5 shadow-lg hero-img"
                alt="Luxury Home">

            </div>

        </div>

    </div>

</section>

<!-- Categories -->

<section class="py-5 bg-light">

    <div class="container">

        <h2 class="fw-bold text-center mb-5">

            Explore by Category

        </h2>

        <div class="row g-4">

            <div class="col-md-3">

                <div class="card border-0 shadow-sm text-center p-4">

                    <h1>🏡</h1>

                    <h5>Homes</h5>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card border-0 shadow-sm text-center p-4">

                    <h1>🏕️</h1>

                    <h5>Cabins</h5>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card border-0 shadow-sm text-center p-4">

                    <h1>🌊</h1>

                    <h5>Beach</h5>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card border-0 shadow-sm text-center p-4">

                    <h1>⛰️</h1>

                    <h5>Mountains</h5>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- Features -->

<section class="container py-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold">

            Why Choose Homely?

        </h2>

    </div>

    <div class="row text-center">

        <div class="col-lg-4">

            <i class="bi bi-shield-check display-4 text-danger"></i>

            <h4 class="mt-3">

                Verified Listings

            </h4>

            <p class="text-muted">

                Every property is carefully verified for quality.

            </p>

        </div>

        <div class="col-lg-4">

            <i class="bi bi-currency-dollar display-4 text-danger"></i>

            <h4 class="mt-3">

                Affordable Prices

            </h4>

            <p class="text-muted">

                Get the best value for your travel budget.

            </p>

        </div>

        <div class="col-lg-4">

            <i class="bi bi-star-fill display-4 text-danger"></i>

            <h4 class="mt-3">

                Trusted Hosts

            </h4>

            <p class="text-muted">

                Connect with reliable hosts worldwide.

            </p>

        </div>

    </div>

</section>

<!-- CTA -->

<section class="py-5 text-center bg-danger text-white">

    <div class="container">

        <h2 class="fw-bold">

            Ready for Your Next Adventure?

        </h2>

        <p class="lead">

            Thousands of amazing places are waiting for you.

        </p>

        <a href="/listings" class="btn btn-light btn-lg rounded-pill px-5">

            Browse Listings

        </a>

    </div>

</section>