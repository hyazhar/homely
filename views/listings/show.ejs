<% layout("/layouts/boilerplate") %>

<div class="container my-2">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <!-- Title -->
            <h2 class="fw-bold mb-3">
                <%= listing.title %>
            </h2>

            <!-- Image Card -->
            <div class="card shadow border-0 rounded-4">

                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top rounded-top-4"
                    alt="<%= listing.title %>"
                    style="height:500px; object-fit:cover;"
                >

                <div class="card-body">

                    <% if (listing.owner) { %>
                     <p class="text-muted">Hosted by <strong><%= listing.owner.username %></strong> </p>
                    <% } else 
                    { %><p class="text-muted"> Hosted by <strong>Homely Host</strong></p>
                    <% } %>
                    <!-- Location -->
                    <p class="text-muted fs-5">
                        📍 <%= listing.location %>, <%= listing.country %>
                    </p>

                    <hr>

                    <!-- Description -->
                    <h5>Description</h5>

                    <p class="text-secondary">
                        <%= listing.description %>
                    </p>

                    <hr>

                    <!-- Price -->
                    <h4 class="text-success fw-bold">
                        ₹ <%= listing.price.toLocaleString("en-IN") %> / night
                    </h4>

                    <!-- Buttons -->
                    <div class="mt-4 d-flex gap-3">

                        <a
                            href="/listings/<%= listing._id %>/edit"
                            class="btn btn-warning px-4">

                            Edit
                        </a>
                        <a
                            href="/listings/<%= listing._id %>/new"
                            class="btn btn-warning px-4">
                            Review
                        </a>
                        <form
                            action="/listings/<%= listing._id %>?_method=DELETE"
                            method="POST">

                            <button
                                class="btn btn-danger px-4">

                                Delete
                            </button>

                        </form>

                        <a
                            href="/listings"
                            class="btn btn-outline-dark px-4">

                            Back
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
<h3 class="mt-5 mb-4 fw-bold text-center ">
    <i class="bi bi-chat-left-text-fill text-danger me-2"></i>
    Guest Reviews
</h3>

<% if (listing.reviews.length === 0) { %>

    <div class="alert alert-light border rounded-4 shadow-sm text-center py-5 ">
        <i class="bi bi-chat-square-text fs-1 text-secondary"></i>
        <h4 class="mt-3">No Reviews Yet</h4>
        <p class="text-muted mb-0">
            Be the first to share your experience.
        </p>
    </div>

<% } else { %>

<div class="row g-4">

    <% listing.reviews.forEach(review => { %>

    <div class="col-lg-6 ">

        <div class="card  border-0 shadow-sm rounded-4 h-100">

            <div class="card-body ">

                <!-- Header -->
                <div class="d-flex justify-content-between align-items-start">

                    <div class="d-flex align-items-center">

                        <div
                            class="rounded-circle bg-danger text-white d-flex justify-content-center align-items-center"
                            style="width:55px;height:55px;">

                            <i class="bi bi-person-fill fs-3"></i>

                        </div>

                        <div class="ms-3">

                            <h5 class="mb-1 fw-bold">
                                <%= review.owner.username %>
                            </h5>

                            <small class="text-muted">
                                <i class="bi bi-calendar3 me-1"></i>
                                <%= review.createdAt.toDateString() %>
                            </small>

                        </div>

                    </div>

                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                        ⭐ <%= review.rating %>/5
                    </span>

                </div>

                <hr>

                <!-- Review Comment -->

                <p class="text-secondary fs-6 mb-4">
                    <%= review.comment %>
                </p>

                <!-- Owner Buttons -->

                <% if(currentUser && review.owner._id.equals(currentUser._id)) { %>

                    <div class="d-flex justify-content-end gap-2">

                        <a
                            href="/listings/<%= listing._id %>/reviews/<%= review._id %>/edit"
                            class="btn btn-outline-primary btn-sm rounded-pill px-3">

                            <i class="bi bi-pencil-square me-1"></i>
                            Edit

                        </a>

                        <form
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                            method="POST">

                            <button
                                class="btn btn-outline-danger btn-sm rounded-pill px-3">

                                <i class="bi bi-trash me-1"></i>
                                Delete

                            </button>

                        </form>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

    <% }) %>

</div>

<% } %>
<!-- Related Listings -->
<div class="container mt-5">

    <h3 class="fw-bold mb-4">
        You May Also Like
    </h3>

    <div class="row g-4">

        <% relatedListings.forEach((item) => { %>

            <div class="col-lg-4 col-md-6">

                <a href="/listings/<%= item._id %>"
                   class="text-decoration-none text-dark">

                    <div class="card h-100 border-0 shadow-sm related-card">

                        <img
                            src="<%= item.image.url %>"
                            alt="<%= item.title %>"
                            class="card-img-top"
                            style="height:220px; object-fit:cover;">

                        <div class="card-body">

                            <h5 class="card-title fw-bold mb-2">
                                <%= item.title %>
                            </h5>

                            <p class="text-muted mb-2">
                                <i class="bi bi-geo-alt-fill text-danger"></i>
                                <%= item.location %>, <%= item.country %>
                            </p>

                            <h6 class="fw-semibold text-success">
                                ₹ <%= item.price.toLocaleString("en-IN") %>
                                <small class="text-muted fw-normal">/ night</small>
                            </h6>

                        </div>

                    </div>

                </a>

            </div>

        <% }) %>

    </div>

</div>