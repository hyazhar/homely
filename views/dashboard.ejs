<% layout("/layouts/boilerplate") %>
    <div class="card border-0 rounded-4 shadow-lg mb-5 text-white"
     style="background:linear-gradient(135deg,#ff5a5f,#ff385c);">

    <div class="card-body p-5">

        <div class="d-flex justify-content-between align-items-center flex-wrap">

            <div>

                <h2 class="fw-bold mb-2">
                    Welcome back,
                    <%= currentUser.username %> 👋
                </h2>

                <p class="mb-0 opacity-75">
                    Manage your listings, reviews and profile from one place.
                </p>

            </div>

            <a href="/listings/new"
               class="btn btn-light rounded-pill px-4 mt-3 mt-lg-0">

                <i class="bi bi-plus-circle me-2"></i>

                New Listing

            </a>

        </div>

    </div>

</div>



    <!-- Statistics -->

    <div class="d-flex justify-content-between">

    <span class="badge bg-success">

        Active

    </span>

    <span class="text-warning">

        ⭐ 4.8

    </span>

</div>


    <!-- Listings -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="fw-bold">

            My Listings

        </h3>

        <a
            href="/listings/new"
            class="btn btn-danger rounded-pill px-4">

            <i class="bi bi-plus-circle me-2"></i>

            Add Listing

        </a>

    </div>



    <% if(listings.length === 0){ %>

        <div class="card border-0 shadow rounded-4">

            <div class="card-body text-center py-5">

                <i class="bi bi-house display-1 text-secondary"></i>

                <h3 class="mt-3">

                    No Listings Yet

                </h3>

                <p class="text-muted">

                    Start hosting by creating your first listing.

                </p>

                <a
                    href="/listings/new"
                    class="btn btn-danger rounded-pill px-4">

                    Create Listing

                </a>

            </div>

        </div>

    <% } else { %>

        <div class="row g-4">

            <% listings.forEach(listing => { %>

                <div class="col-lg-4 col-md-6">

                    <div class="card border-0 shadow rounded-4 h-100">

                        <img
                            src="<%= listing.image.url %>"
                            class="card-img-top"
                            style="height:220px;object-fit:cover;">

                        <div class="card-body">

                            <h5 class="fw-bold">

                                <%= listing.title %>

                            </h5>

                            <p class="text-muted mb-2">

                                <i class="bi bi-geo-alt-fill"></i>

                                <%= listing.location %>,
                                <%= listing.country %>

                            </p>

                            <h5 class="text-danger fw-bold">

                                ₹<%= listing.price %>

                                <small class="text-muted fs-6">

                                    / night

                                </small>

                            </h5>

                        </div>

                        <div class="card-footer bg-white border-0">

                            <div class="d-flex justify-content-between">

                                <a
                                    href="/listings/<%= listing._id %>"
                                    class="btn btn-outline-dark btn-sm rounded-pill">

                                    View

                                </a>

                                <a
                                    href="/listings/<%= listing._id %>/edit"
                                    class="btn btn-outline-primary btn-sm rounded-pill">

                                    Edit

                                </a>

                                <form
                                    action="/listings/<%= listing._id %>?_method=DELETE"
                                    method="POST">

                                    <button
                                        class="btn btn-outline-danger btn-sm rounded-pill">

                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>