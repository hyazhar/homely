<% layout("/layouts/boilerplate") %>
<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card border-0 shadow rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="bg-danger text-white p-5 text-center">

                    <img
                        src="<%= user.avatar?.url || 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>"
                        class="rounded-circle border border-4 border-white shadow"
                        width="140"
                        height="140"
                        style="object-fit: cover;">

                    <h2 class="mt-3 fw-bold">
                        <%= user.username %>
                    </h2>

                    <p class="mb-0 opacity-75">
                        <i class="bi bi-envelope-fill"></i>
                        <%= user.email %>
                    </p>

                </div>

                <!-- Body -->
                <div class="card-body p-5">

                    <div class="row">

                        <!-- Left -->
                        <div class="col-lg-7">

                            <h4 class="fw-bold mb-4">
                                Profile Information
                            </h4>

                            <table class="table table-borderless">

                                <tr>
                                    <th width="170">
                                        <i class="bi bi-person-fill text-danger"></i>
                                        Username
                                    </th>

                                    <td>
                                        <%= user.username %>
                                    </td>
                                </tr>

                                <tr>

                                    <th>
                                        <i class="bi bi-envelope-fill text-danger"></i>
                                        Email
                                    </th>

                                    <td>
                                        <%= user.email %>
                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        <i class="bi bi-telephone-fill text-danger"></i>
                                        Phone
                                    </th>

                                    <td>
                                        <%= user.phone || "Not Added" %>
                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        <i class="bi bi-geo-alt-fill text-danger"></i>
                                        Location
                                    </th>

                                    <td>
                                        <%= user.location || "Not Added" %>
                                    </td>

                                </tr>

                                <tr>

                                    <th>
                                        <i class="bi bi-calendar-check-fill text-danger"></i>
                                        Joined
                                    </th>

                                    <td>
                                        <%= user.createdAt.toDateString() %>
                                    </td>

                                </tr>

                            </table>

                        </div>

                        <!-- Right -->
                        <div class="col-lg-5">

                            <h4 class="fw-bold mb-4">
                                About Me
                            </h4>

                            <div class="border rounded-4 p-4 bg-light">

                                <p class="text-muted mb-0">

                                    <%= user.bio || "No bio added yet." %>

                                </p>

                            </div>

                            <hr class="my-4">

                            <h5 class="fw-bold mb-3">
                                Statistics
                            </h5>

                            <div class="row text-center g-3">

                                <div class="col-6">

                                    <div class="card border-0 shadow-sm rounded-4">

                                        <div class="card-body">

                                            <h3 class="text-danger fw-bold">
                                                <%= totalListings %>
                                            </h3>

                                            <small class="text-muted">
                                                Listings
                                            </small>

                                        </div>

                                    </div>

                                </div>

                                <div class="col-6">

                                    <div class="card border-0 shadow-sm rounded-4">

                                        <div class="card-body">

                                            <h3 class="text-warning fw-bold">
                                                <%= totalReviews %>
                                            </h3>

                                            <small class="text-muted">
                                                Reviews
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <div class="d-grid mt-4">

    <a
        href="/profile/edit"
        class="btn btn-danger btn-lg rounded-pill">

        <i class="bi bi-pencil-square me-2"></i>

        Edit Profile

    </a>

</div>

<!-- Danger Zone -->

<div class="card border-danger mt-5">

    <div class="card-header bg-danger text-white">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        Danger Zone

    </div>

    <div class="card-body">

        <p class="text-muted mb-3">

            Deleting your account is permanent. This action cannot be undone.

        </p>

        <ul class="small text-muted mb-4">

            <li>Your profile will be permanently deleted.</li>

            <li>All your listings will be deleted.</li>

            <li>All reviews written by you will be deleted.</li>

            <li>You will be logged out immediately.</li>

        </ul>

        <form
            action="/profile?_method=DELETE"
            method="POST"
            onsubmit="return confirm('Are you sure? This will permanently delete your account and all associated data.');">

            <button
                type="submit"
                class="btn btn-outline-danger w-100 rounded-pill">

                <i class="bi bi-trash3-fill me-2"></i>

                Delete My Account

            </button>

        </form>

    </div>

</div>
                            

                        </div>
                        
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>