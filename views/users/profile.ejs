<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-xl-10 col-lg-11">

            <!-- ================= PROFILE CARD ================= -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Profile Header -->
                <div class="bg-danger text-white text-center py-5 px-3">

                    <img
                        src="<%= user.avatar?.url || 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>"
                        alt="Profile Avatar"
                        class="rounded-circle border border-4 border-white shadow"
                        width="140"
                        height="140"
                        style="object-fit: cover;">

                    <h2 class="fw-bold mt-3 mb-1">
                        <%= user.username %>
                    </h2>

                    <p class="mb-0 opacity-75">
                        <i class="bi bi-envelope-fill me-1"></i>
                        <%= user.email %>
                    </p>

                    <% if (currentUser.role === "host") { %>

                        <span class="badge bg-light text-danger rounded-pill px-3 py-2 mt-3">
                            <i class="bi bi-house-heart-fill me-1"></i>
                            Host
                        </span>

                    <% } else if (currentUser.role === "admin") { %>

                        <span class="badge bg-light text-danger rounded-pill px-3 py-2 mt-3">
                            <i class="bi bi-shield-fill-check me-1"></i>
                            Administrator
                        </span>

                    <% } else { %>

                        <span class="badge bg-light text-danger rounded-pill px-3 py-2 mt-3">
                            <i class="bi bi-person-fill me-1"></i>
                            User
                        </span>

                    <% } %>

                </div>


                <!-- ================= PROFILE BODY ================= -->
                <div class="card-body p-4 p-lg-5">

                    <div class="row g-5">

                        <!-- ================= LEFT COLUMN ================= -->
                        <div class="col-lg-7">

                            <h4 class="fw-bold mb-4">
                                <i class="bi bi-person-vcard-fill text-danger me-2"></i>
                                Profile Information
                            </h4>

                            <div class="table-responsive">

                                <table class="table table-borderless align-middle mb-0">

                                    <tbody>

                                        <tr class="border-bottom">

                                            <th class="py-3" style="width: 180px;">
                                                <i class="bi bi-person-fill text-danger me-2"></i>
                                                Username
                                            </th>

                                            <td class="py-3 text-muted">
                                                <%= user.username %>
                                            </td>

                                        </tr>

                                        <tr class="border-bottom">

                                            <th class="py-3">
                                                <i class="bi bi-envelope-fill text-danger me-2"></i>
                                                Email
                                            </th>

                                            <td class="py-3 text-muted">
                                                <%= user.email %>
                                            </td>

                                        </tr>

                                        <tr class="border-bottom">

                                            <th class="py-3">
                                                <i class="bi bi-telephone-fill text-danger me-2"></i>
                                                Phone
                                            </th>

                                            <td class="py-3 text-muted">
                                                <%= user.phone || "Not Added" %>
                                            </td>

                                        </tr>

                                        <tr class="border-bottom">

                                            <th class="py-3">
                                                <i class="bi bi-geo-alt-fill text-danger me-2"></i>
                                                Location
                                            </th>

                                            <td class="py-3 text-muted">
                                                <%= user.location || "Not Added" %>
                                            </td>

                                        </tr>

                                        <tr>

                                            <th class="py-3">
                                                <i class="bi bi-calendar-check-fill text-danger me-2"></i>
                                                Joined
                                            </th>

                                            <td class="py-3 text-muted">
                                                <%= user.createdAt.toDateString() %>
                                            </td>

                                        </tr>

                                    </tbody>

                                </table>

                            </div>

                        </div>


                        <!-- ================= RIGHT COLUMN ================= -->
                        <div class="col-lg-5">

                            <!-- About -->
                            <h4 class="fw-bold mb-4">
                                <i class="bi bi-chat-square-text-fill text-danger me-2"></i>
                                About Me
                            </h4>

                            <div class="bg-light border rounded-4 p-4">

                                <p class="text-muted mb-0 lh-lg">

                                    <%= user.bio || "No bio added yet." %>

                                </p>

                            </div>


                            <!-- Statistics -->
                            <h5 class="fw-bold mt-5 mb-3">

                                <i class="bi bi-bar-chart-fill text-danger me-2"></i>
                                Statistics

                            </h5>

                            <div class="row g-3">

                                <div class="col-6">

                                    <div class="card border-0 bg-light shadow-sm rounded-4 text-center h-100">

                                        <div class="card-body py-4">

                                            <i class="bi bi-house-door-fill text-danger fs-3"></i>

                                            <h3 class="text-danger fw-bold mt-2 mb-0">
                                                <%= totalListings %>
                                            </h3>

                                            <small class="text-muted">
                                                Listings
                                            </small>

                                        </div>

                                    </div>

                                </div>


                                <div class="col-6">

                                    <div class="card border-0 bg-light shadow-sm rounded-4 text-center h-100">

                                        <div class="card-body py-4">

                                            <i class="bi bi-star-fill text-warning fs-3"></i>

                                            <h3 class="text-warning fw-bold mt-2 mb-0">
                                                <%= totalReviews %>
                                            </h3>

                                            <small class="text-muted">
                                                Reviews
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- ================= ACTIONS ================= -->
                            <div class="d-grid gap-2 mt-4">

                                <a
                                    href="/profile/edit"
                                    class="btn btn-danger btn-lg rounded-pill">

                                    <i class="bi bi-pencil-square me-2"></i>
                                    Edit Profile

                                </a>


                                <% if (currentUser.role === "user") { %>

                                    <% if (
                                        currentUser.hostApplication?.status === "none" ||
                                        !currentUser.hostApplication?.status
                                    ) { %>

                                        <form action="/profile/apply-host" method="POST">

                                            <button
                                                type="submit"
                                                class="btn btn-dark btn-lg rounded-pill w-100">

                                                <i class="bi bi-house-heart me-2"></i>
                                                Apply to Become a Host

                                            </button>

                                        </form>


                                    <% } else if (
                                        currentUser.hostApplication.status === "pending"
                                    ) { %>

                                        <button
                                            class="btn btn-warning btn-lg rounded-pill w-100"
                                            disabled>

                                            <i class="bi bi-hourglass-split me-2"></i>
                                            Host Application Pending

                                        </button>


                                    <% } else if (
                                        currentUser.hostApplication.status === "rejected"
                                    ) { %>

                                        <form action="/profile/apply-host" method="POST">

                                            <button
                                                type="submit"
                                                class="btn btn-outline-dark btn-lg rounded-pill w-100">

                                                <i class="bi bi-arrow-repeat me-2"></i>
                                                Apply Again

                                            </button>

                                        </form>

                                    <% } %>

                                <% } %>

                            </div>

                        </div>

                    </div>


                    <!-- ================= DANGER ZONE ================= -->
                    <% if (currentUser.role !== "admin") { %>

                        <hr class="my-5">

                        <div class="card border-danger shadow-sm rounded-4 overflow-hidden">

                            <div class="card-header bg-danger text-white py-3">

                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Danger Zone</strong>

                            </div>

                            <div class="card-body p-4">

                                <div class="row align-items-center">

                                    <div class="col-lg-8">

                                        <h5 class="fw-bold text-danger mb-2">
                                            Delete Account
                                        </h5>

                                        <p class="text-muted mb-3">
                                            Deleting your account is permanent.
                                            This action cannot be undone.
                                        </p>

                                        <ul class="small text-muted mb-0 ps-3">

                                            <li>Your profile will be permanently deleted.</li>

                                            <li>All your listings will be deleted.</li>

                                            <li>All reviews written by you will be deleted.</li>

                                            <li>You will be logged out immediately.</li>

                                        </ul>

                                    </div>


                                    <div class="col-lg-4 mt-4 mt-lg-0">

                                        <form
                                            action="/profile?_method=DELETE"
                                            method="POST"
                                            onsubmit="return confirm('Are you sure? This will permanently delete your account and all associated data.');">

                                            <button
                                                type="submit"
                                                class="btn btn-outline-danger w-100 rounded-pill">

                                                <i class="bi bi-trash3-fill me-2"></i>
                                                Delete My Account

                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>

                    <% } %>

                </div>

            </div>

        </div>

    </div>

</div>
