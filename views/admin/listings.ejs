<% layout("/layouts/boilerplate") %>

<div class="container py-4">

    <!-- Header -->

    <div class="card border-0 shadow rounded-4 mb-4">

        <div class="card-body d-flex justify-content-between align-items-center">

            <div>

                <h2 class="fw-bold mb-1">
                    <i class="bi bi-house-door-fill text-danger me-2"></i>
                    Manage Listings
                </h2>

                <p class="text-muted mb-0">
                    Total Listings :
                    <strong><%= listings.length %></strong>
                </p>

            </div>

            <a
                href="/admin"
                class="btn btn-dark rounded-pill px-4">

                <i class="bi bi-arrow-left me-2"></i>

                Dashboard

            </a>

        </div>

    </div>

    <% if(listings.length === 0){ %>

        <div class="alert alert-info text-center shadow-sm rounded-4">

            <h5>No Listings Found</h5>

        </div>

    <% } else { %>

    <div class="card border-0 shadow rounded-4">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">

                    <tr>

                        <th>#</th>

                        <th>Image</th>

                        <th>Listing</th>

                        <th>Owner</th>

                        <th>Location</th>

                        <th>Price</th>

                        <th>Status</th>

                        <th class="text-center">

                            Actions

                        </th>

                    </tr>

                </thead>

                <tbody>

                    <% listings.forEach((listing,index)=>{ %>

                    <tr>

                        <td>

                            <%= index+1 %>

                        </td>

                        <!-- Image -->

                        <td>

                            <img

                                src="<%= listing.image.url %>"

                                width="90"

                                height="65"

                                class="rounded shadow-sm"

                                style="object-fit:cover;">

                        </td>

                        <!-- Title -->

                        <td>

                            <h6 class="fw-bold mb-1">

                                <%= listing.title %>

                            </h6>

                            <small class="text-muted">

                                ID :
                                <%= listing._id.toString().slice(-6) %>

                            </small>

                        </td>

                        <!-- Owner -->

                        <td>

                            <% if(listing.owner){ %>

                                <div class="d-flex align-items-center">

                                    <img

                                        src="<%= listing.owner.avatar?.url || 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>"

                                        class="rounded-circle me-2"

                                        width="40"

                                        height="40"

                                        style="object-fit:cover;">

                                    <span>

                                        <%= listing.owner.username %>

                                    </span>

                                </div>

                            <% }else{ %>

                                <span class="text-muted">

                                    Unknown

                                </span>

                            <% } %>

                        </td>

                        <!-- Location -->

                        <td>

                            <%= listing.location %>

                            <br>

                            <small class="text-muted">

                                <%= listing.country %>

                            </small>

                        </td>

                        <!-- Price -->

                        <td>

                            <span class="fw-bold text-success">

                                ₹ <%= listing.price.toLocaleString("en-IN") %>

                            </span>

                        </td>

                        <!-- Status -->

                        <td>

                            <span class="badge bg-success">

                                Active

                            </span>

                        </td>

                        <!-- Buttons -->

                        <td>

                            <div class="d-flex justify-content-center gap-2">

                                <!-- View -->

                                <a

                                    href="/listings/<%= listing._id %>"

                                    class="btn btn-sm btn-outline-dark rounded-pill">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <!-- Edit -->

                                <a

                                    href="/listings/<%= listing._id %>/edit"

                                    class="btn btn-sm btn-outline-primary rounded-pill">

                                    <i class="bi bi-pencil-square"></i>

                                </a>

                                <!-- Delete -->

                                <form

                                    action="/admin/listings/<%= listing._id %>?_method=DELETE"

                                    method="POST"

                                    onsubmit="return confirm('Delete this listing?')">

                                    <button

                                        class="btn btn-sm btn-outline-danger rounded-pill">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

    <% } %>

</div>