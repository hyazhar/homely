<% layout("/layouts/boilerplate") %>

<div class="container py-4">

    <!-- Page Header -->
    <div class="card border-0 shadow rounded-4 mb-4">

        <div class="card-body d-flex justify-content-between align-items-center">

            <div>

                <h2 class="fw-bold mb-1">
                    <i class="bi bi-people-fill text-primary me-2"></i>
                    Manage Users
                </h2>

                <p class="text-muted mb-0">
                    Total Users :
                    <strong><%= users.length %></strong>
                </p>

            </div>

            <a href="/admin" class="btn btn-dark rounded-pill px-4">

                <i class="bi bi-arrow-left me-2"></i>

                Dashboard

            </a>

        </div>

    </div>

    <% if(users.length === 0){ %>

        <div class="alert alert-info text-center shadow rounded-4">

            No users found.

        </div>

    <% } else { %>

    <div class="card border-0 shadow rounded-4">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">

                    <tr>

                        <th>#</th>

                        <th>User</th>

                        <th>Email</th>

                        <th>Role</th>

                        <th>Location</th>

                        <th>Joined</th>

                        <th class="text-center">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    <% users.forEach((user,index)=>{ %>

                    <tr>

                        <td>

                            <%= index+1 %>

                        </td>

                        <!-- User -->

                        <td>

                            <div class="d-flex align-items-center">

                                <img

                                    src="<%= user.avatar?.url || 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>"

                                    class="rounded-circle border"

                                    width="55"

                                    height="55"

                                    style="object-fit:cover;">

                                <div class="ms-3">

                                    <h6 class="mb-0 fw-bold">

                                        <%= user.username %>

                                    </h6>

                                    <small class="text-muted">

                                        ID :
                                        <%= user._id.toString().slice(-6) %>

                                    </small>

                                </div>

                            </div>

                        </td>

                        <!-- Email -->

                        <td>

                            <%= user.email %>

                        </td>

                        <!-- Role -->

                        <td>

                            <% if(user.role==="admin"){ %>

                                <span class="badge bg-danger px-3 py-2">

                                    Admin

                                </span>

                            <% }else if(user.role==="host"){ %>

                                <span class="badge bg-success px-3 py-2">

                                    Host

                                </span>

                            <% }else{ %>

                                <span class="badge bg-secondary px-3 py-2">

                                    User

                                </span>

                            <% } %>

                        </td>

                        <!-- Location -->

                        <td>

                            <%= user.location || "Not Added" %>

                        </td>

                        <!-- Date -->

                        <td>

                            <%= user.createdAt.toDateString() %>

                        </td>

                        <!-- Buttons -->

                        <td>

                            <div class="d-flex justify-content-center gap-2">

                                <!-- View Profile -->

                                <a

                                    href="/admin/users/<%= user._id %>"

                                    class="btn btn-sm btn-outline-primary rounded-pill">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <!-- Edit -->

                                <a

                                    href="/admin/users/<%= user._id %>/edit"

                                    class="btn btn-sm btn-outline-warning rounded-pill">

                                    <i class="bi bi-pencil"></i>

                                </a>

                                <!-- Delete -->

                                <form

                                    action="/admin/users/<%= user._id %>?_method=DELETE"

                                    method="POST"

                                    onsubmit="return confirm('Delete this user?')">

                                    <button

                                        class="btn btn-sm btn-outline-danger rounded-pill">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

    <% } %>

</div>